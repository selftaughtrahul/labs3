# Environment label: development or production.
# manage.py defaults to development. WSGI, ASGI, and the container default to production.
DJANGO_ENV=production

# Required for the production label. At least 50 characters, not a django-insecure- key.
# The placeholder below is rejected on purpose. Generate a unique value before use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Comma-separated hostnames. A wildcard is rejected in production.
DJANGO_ALLOWED_HOSTS=example.com

# Comma-separated origins, including scheme. Example: https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# true behind HTTPS. Set false only for a local HTTP container.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_USE_X_FORWARDED_HOST=true
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=labs3
POSTGRES_USER=labs3
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

WEB_CONCURRENCY=3
